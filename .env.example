# Copia este archivo como .env y llena los valores de tu proyecto de Supabase
# (Project Settings → API). Nunca subas .env al repositorio.

# URL del proyecto, por ejemplo https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Llave publishable (sb_publishable_...) o anon. NUNCA la service_role / secret.
SUPABASE_KEY=

# Opcional
PORT=3000

# Usuario confirmado SOLO para pruebas (Día 5). Nunca uses una cuenta real.
TEST_EMAIL=
TEST_PASSWORD=
